# Copy to .env and fill in (Vercel: Project > Settings > Environment Variables)
# Powers Gemini cloud replies. Get one free at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Optional: Supabase sync (app works fully offline/localStorage without these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: local Ollama daemon (desktop/localhost only — browsers on Vercel
# cannot reach a visitor's localhost, so Local AI works in `npm run dev` only)
VITE_OLLAMA_URL=http://localhost:11434

# Firebase (Google login + cloud tickets/events). Create a project at
# https://console.firebase.google.com, enable Google sign-in, Firestore and
# Realtime Database, then paste the web-app config values below.
# Without these, the app runs fully in Guest mode (local only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
