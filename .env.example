# Copy to .env and fill in (Vercel: Project > Settings > Environment Variables)
# Powers Gemini cloud replies. Get one free at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Optional: Supabase sync (app works fully offline/localStorage without these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: local Ollama daemon (desktop/localhost only — browsers on Vercel
# cannot reach a visitor's localhost, so Local AI works in `npm run dev` only)
VITE_OLLAMA_URL=http://localhost:11434
